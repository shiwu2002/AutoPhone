{
  "_comment": "AutoPhone 配置文件 - 新格式",
  "_env_hint": "API 密钥建议通过环境变量设置：export AUTOPHONE_API_KEY='your-key'",

  "model": {
    "_comment": "provider 可选值：local, anthropic, openai",
    "provider": "openai",
    "providers": {
      "local": {
        "base_url": "http://localhost:11434/v1",
        "model": "qwen3.5:9b",
        "api_key": "ollama",
        "max_tokens": 696325
      },
      "anthropic": {
        "base_url": "https://api.anthropic.com",
        "model": "claude-opus-4-6-20251101",
        "api_key": ""
      },
      "openai": {
        "base_url": "https://api-inference.modelscope.cn/v1",
        "model": "ZhipuAI/AutoGLM-Phone-9B",
        "api_key": "ms-fd50204a-9b29-40e0-a29a-1af24569e10f"
      }
    }
  },

  "agent": {
    "max_steps": 0,
    "device_id": null,
    "verbose": true,
    "lang": "cn",
    "max_context_rounds": 5,
    "remember_app_info": true,
    "max_repeated_actions": 3,
    "enable_repeat_detection": true
  },

  "device": {
    "type": "adb",
    "remote_address": null,
    "auto_connect": true
  },

  "coordinate_optimization": {
    "enabled": true,
    "click_offset_x": 8,
    "click_offset_y": 8,
    "use_region_click": true,
    "min_click_region": 30
  },

  "timing": {
    "action": {
      "keyboard_switch_delay": 1.0,
      "text_clear_delay": 1.0,
      "text_input_delay": 1.0,
      "keyboard_restore_delay": 1.0
    },
    "device": {
      "default_tap_delay": 1.0,
      "default_double_tap_delay": 1.0,
      "double_tap_interval": 0.1,
      "default_long_press_delay": 1.0,
      "default_swipe_delay": 1.0,
      "default_back_delay": 1.0,
      "default_home_delay": 1.0,
      "default_launch_delay": 1.0
    },
    "connection": {
      "adb_restart_delay": 2.0,
      "server_restart_delay": 1.0
    }
  },

  "server": {
    "host": "0.0.0.0",
    "port": 5001,
    "enable_cors": true,
    "auth_enabled": false,
    "auth_token": ""
  }
}
